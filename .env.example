# Leave empty in development (Vite proxies /api to http://localhost:8080).
# In production, set this to your deployed backend URL BEFORE running `npm run build`
# (Vite bakes it into the build). No trailing slash.
VITE_API_BASE_URL=https://crm-backend-production-7244.up.railway.app
# Example: VITE_API_BASE_URL=https://api.yourdomain.com
